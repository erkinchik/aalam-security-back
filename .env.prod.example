# Образ, который docker compose pull тянет из GHCR.
# Замени owner/repo на свои (обязательно в нижнем регистре).
API_IMAGE=ghcr.io/owner/repo-backend:latest

# Postgres — используются и docker compose, и приложением через DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-with-strong-password
POSTGRES_DB=alarm_sos

# Подключение из контейнера api к контейнеру postgres (внутри docker network).
DATABASE_URL=postgresql://postgres:replace-me-with-strong-password@postgres:5432/alarm_sos?connection_limit=5&pool_timeout=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — сгенерируй сильные значения, например: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

PORT=3000
