# Production environment template for the VPS.
# Copy to .env on the server, fill in real values, NEVER commit it back.

# Required: production mode toggles Swagger off and seed refuses to run.
NODE_ENV=production

PORT=3000

# CORS — list every origin that talks to the API (admin panel, mobile build webview).
# Without this Joi default still loads localhost, so set explicitly in prod.
ALLOWED_ORIGINS=https://admin.your-domain.com

# Image pulled by `docker compose -f docker-compose.prod.yml`.
# Replace owner/repo with the lowercase GHCR path.
API_IMAGE=ghcr.io/owner/repo-backend:latest

# Postgres — used by docker compose to provision postgres AND by the app via DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-with-strong-password
POSTGRES_DB=alarm_sos

# Must match POSTGRES_* above; `statement_timeout` caps long queries.
DATABASE_URL=postgresql://postgres:replace-me-with-strong-password@postgres:5432/alarm_sos?connection_limit=5&pool_timeout=10&statement_timeout=30000

# Redis — REDIS_PASSWORD is required in prod (compose passes --requirepass to redis-server).
# Generate via: openssl rand -hex 32
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me-with-openssl-rand-hex-32

# JWT — generate via `openssl rand -hex 48` (min 32 chars by Joi).
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-hex-48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Observability (PRD-5 / PRD-6 / PRD-11)
LOG_LEVEL=info
# Sentry — paste DSN from your project settings; leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Prometheus /metrics auth — Prometheus scraper must send ?token=<this>.
# Generate via: openssl rand -hex 24
METRICS_TOKEN=replace-me-with-openssl-rand-hex-24

# Telegram phone-verification bot — shared with the bot service.
# Generate secret via: openssl rand -hex 32
TELEGRAM_BOT_SECRET=replace-me-with-openssl-rand-hex-32
TELEGRAM_BOT_USERNAME=sos_security_bot
