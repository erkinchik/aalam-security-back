generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OPERATOR
  ADMIN
}

enum EmergencyStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  CLOSED
}

enum OrganizationType {
  PERSONAL
  BUSINESS
}

enum OrgMemberRole {
  OWNER
  MANAGER
  OPERATOR
  MEMBER
}

enum OrganizationApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmergencyType {
  PERSONAL
  VENUE
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  password         String
  role             Role                  @default(USER)
  pushToken        String?
  emailVerifiedAt  DateTime?
  displayName      String?
  phone            String?
  phoneVerifiedAt  DateTime?
  telegramId       String?               @unique
  telegramUsername String?
  individualSubscriptionActive Boolean   @default(false)
  subscriptionExpiresAt DateTime?
  planId           String?
  /// OPERATOR only: on shift means new SOS sessions are broadcast to this user.
  onShift          Boolean               @default(false)
  shiftStartedAt   DateTime?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  emergencies      EmergencySession[]
  assignedSessions EmergencySession[]    @relation("OperatorSessions")
  orgMemberships   OrganizationMember[]
  emergencyContacts EmergencyContact[]
  passwordResetTokens PasswordResetToken[]
  organizationApplications OrganizationApplication[]
  subscriptionRequests SubscriptionRequest[]

  @@index([role, onShift])
  @@index([deletedAt])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      OrganizationType @default(PERSONAL)
  slug      String   @unique
  /// Invite code for BUSINESS orgs (employees join without binding to a single venue). Null for PERSONAL.
  inviteCode String? @unique
  createdAt DateTime @default(now())

  members   OrganizationMember[]
  venues    Venue[]
  sessions  EmergencySession[]
  approvedApplications OrganizationApplication[] @relation("ApplicationApprovedOrg")

  @@index([slug])
}

model Venue {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  apartment      String?
  floor          String?
  entrance       String?
  doorCode       String?
  addressNotes   String?
  latitude       Float?
  longitude      Float?
  inviteCode     String   @unique
  createdAt      DateTime @default(now())

  operators      OrganizationMember[]
  sessions       EmergencySession[]

  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgMemberRole
  venueId        String?
  venue          Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([userId])
  @@index([organizationId])
  @@index([userId])
}



model EmergencySession {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  organizationId     String?          // Optional for legacy sessions; required for new
  organization       Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  venueId            String?
  venue              Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  status             EmergencyStatus  @default(NEW)
  emergencyType      EmergencyType    @default(PERSONAL)
  assignedOperatorId String?
  assignedOperator   User?            @relation("OperatorSessions", fields: [assignedOperatorId], references: [id])
  createdAt          DateTime         @default(now())
  closedAt           DateTime?
  resolution         String?
  locations          EmergencyLocation[]

  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
  @@index([assignedOperatorId])
}

model EmergencyLocation {
  id        String           @id @default(uuid())
  sessionId String
  session   EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float
  createdAt DateTime         @default(now())

  @@index([sessionId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  isTrusted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model OrganizationApplication {
  id                 String                         @id @default(uuid())
  userId             String
  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  organizationType   String
  branches           Json
  contactEmail       String
  contactPhone       String
  description        String?
  status             OrganizationApplicationStatus  @default(PENDING)
  rejectionReason    String?
  approvedOrganizationId String?
  approvedOrganization   Organization?              @relation("ApplicationApprovedOrg", fields: [approvedOrganizationId], references: [id], onDelete: SetNull)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  attachments        OrganizationApplicationAttachment[]

  @@index([userId])
  @@index([status])
  @@index([approvedOrganizationId])
}

model SubscriptionRequest {
  id              String                    @id @default(uuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment         String?
  status          SubscriptionRequestStatus @default(PENDING)
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrganizationApplicationAttachment {
  id            String                  @id @default(uuid())
  applicationId String
  application   OrganizationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  sizeBytes     Int?
  storageKey    String?
  createdAt     DateTime                @default(now())

  @@index([applicationId])
}
