# Application
NODE_ENV=development
PORT=3000

# CORS — origins allowed to call HTTP API and connect to /ws (comma-separated).
# In production must list real frontend domains; here are local Vite ports.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Postgres — read by docker-compose to provision the postgres service.
# DATABASE_URL must agree with these credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alarm_sos

# DATABASE_URL — use `@postgres:5432` when running in docker-compose,
# `@localhost:5432` when running the app outside the container.
# `statement_timeout=30000` (30s) caps runaway queries so a slow report can't
# block emergency-session updates.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/alarm_sos?connection_limit=5&pool_timeout=10&statement_timeout=30000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD= (set in prod)

# JWT — dev-only secrets here. In prod generate via: openssl rand -hex 48
# Joi schema requires min 32 chars.
JWT_ACCESS_SECRET=dev-only-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=dev-only-refresh-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional overrides for `npx prisma db seed` in dev.
# SEED_ADMIN_PASSWORD=...
# SEED_OPERATOR_PASSWORD=...
# SEED_USER_PASSWORD=...

# Observability (PRD-5/6/11)
LOG_LEVEL=debug
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_TRACES_SAMPLE_RATE=0.05
# METRICS_TOKEN=  (leave empty → /metrics is open; useful for local dev)

# Telegram phone-verification bot.
# TELEGRAM_BOT_SECRET — shared with the bot service; min 32 chars.
#   Generate via: openssl rand -hex 32
# TELEGRAM_BOT_USERNAME — bot username without @, used to build t.me deep-link.
TELEGRAM_BOT_SECRET=dev-only-bot-secret-at-least-32-chars-long
TELEGRAM_BOT_USERNAME=sos_security_dev_bot
